{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|EnterWorktree|ExitWorktree|Agent|mcp__ccd_host__sync_with_base_branch",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-writes.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
